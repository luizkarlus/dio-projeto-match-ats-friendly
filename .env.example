# Copie para .env e preencha se quiser habilitar a camada de IA.
# Sem AI_API_KEY, a aplicação funciona no modo determinístico local.

PORT=8787

# Qualquer provedor compatível com a API de chat da OpenAI.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=45000

# Máximo de requisições por minuto, por IP, no endpoint de análise.
RATE_LIMIT_PER_MINUTE=12
